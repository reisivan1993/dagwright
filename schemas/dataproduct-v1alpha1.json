      "additionalProperties": false,
      "description": "A declared statistical anomaly signal; evaluation is outside this checkpoint.",
      "patternProperties": {
        "^x-[a-z][a-z0-9]*(?:[./-][a-z][a-z0-9]*)*$": {
          "description": "Namespaced extension value."
        }
      },
      "properties": {
        "asset": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Asset",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "static_threshold",
            "relative_change",
            "standard_deviation"
          ],
          "title": "Method",
          "type": "string"
        },
        "metric": {
          "enum": [
            "row_count",
            "freshness",
            "null_rate",
            "latency",
            "cost"
          ],
          "title": "Metric",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "threshold": {
          "exclusiveMinimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "window": {
          "pattern": "^P(?:[0-9]+D(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+(?:\\.[0-9]+)?S)?)?|T(?:[0-9]+H(?:[0-9]+M)?(?:[0-9]+(?:\\.[0-9]+)?S)?|[0-9]+M(?:[0-9]+(?:\\.[0-9]+)?S)?|[0-9]+(?:\\.[0-9]+)?S))$",
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "id",
        "asset",
        "metric",
        "method",
        "threshold",
        "window"
      ],
      "title": "AnomalyRule",
      "type": "object"
    },
